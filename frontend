# ===================================================
# REPORT WEATHER EVENT
# ===================================================

elif page == "Report Weather Event":

    st.subheader("📢 Report a Weather Event")

    st.write(
        "Citizens can submit local weather observations "
        "to help improve hyperlocal weather awareness."
    )

    with st.form("weather_report"):

        col1, col2 = st.columns(2)

        with col1:

            name = st.text_input(
                "Your Name"
            )

            location = st.text_input(
                "Location",
                placeholder="Example: Dewas"
            )

            event_type = st.selectbox(
                "Weather Event",
                [
                    "Heavy Rainfall",
                    "Flood",
                    "Storm",
                    "Heatwave",
                    "Fog",
                    "Dust Storm",
                    "Other"
                ]
            )

        with col2:

            description = st.text_area(
                "Describe the Event",
                placeholder="Describe what you observed..."
            )

            image = st.file_uploader(
                "Upload Image",
                type=["jpg", "jpeg", "png"]
            )

        submitted = st.form_submit_button(
            "Submit Report"
        )

    if submitted:

        if location and description:

            trust_score = random.randint(60, 95)

            st.success(
                "Your weather report has been submitted successfully!"
            )

            st.info(
                f"Initial AI Trust Score: {trust_score}%"
            )

            st.write(
                "The report will be cross-verified with "
                "other available weather sources."
            )

        else:

            st.warning(
                "Please provide location and description."
            )


# ===================================================
# REPORTS
# ===================================================

elif page == "Reports":

    st.subheader("📋 Citizen Weather Reports")

    search = st.text_input(
        "Search reports",
        placeholder="Search by location or event..."
    )

    filtered_data = weather_data.copy()

    if search:

        filtered_data = filtered_data[
            filtered_data["Location"].str.contains(
                search,
                case=False
            )
            |
            filtered_data["Event"].str.contains(
                search,
                case=False
            )
        ]

    st.dataframe(
        filtered_data,
        use_container_width=True,
        hide_index=True
    )

    st.markdown("---")

    st.subheader("Trust Score Explanation")

    st.write(
        """
        The VayuDrishti concept uses a graded Trust Score
        instead of a simple True/False decision.

        The score can consider:

        • Source credibility  
        • Multiple citizen reports  
        • Location consistency  
        • Time consistency  
        • Weather-source verification  
        • Image/metadata verification  
        • Duplicate detection
        """
    )


